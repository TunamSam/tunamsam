---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

const posts = [
  {
    title: "Kenapa Website Lambat Bisa Mengurangi Closing Client",
    excerpt:
      "Riset terbaru menunjukkan bahwa delay 1 detik pada loading website dapat menurunkan conversion rate bisnis.",
    date: "12 Mei 2026",
    category: "Performance",
    slug: "https://web.dev/articles/vitals"
  },

  {
    title: "Telegram Mini Apps: Peluang Baru untuk Bisnis Digital di 2026",
    excerpt:
      "Mini Apps membuka peluang baru untuk dashboard, toko online, dan membership langsung di Telegram.",
    date: "09 Mei 2026",
    category: "Mini Apps",
    slug: "https://core.telegram.org/bots/webapps"
  },

  {
    title: "Core Web Vitals dan Pengaruhnya terhadap Ranking Google",
    excerpt:
      "Google kini memprioritaskan pengalaman pengguna melalui Core Web Vitals.",
    date: "05 Mei 2026",
    category: "SEO",
    slug: "https://developers.google.com/search/docs/appearance/core-web-vitals"
  },

  {
    title: "WhatsApp Automation untuk UMKM",
    excerpt:
      "Otomatisasi customer service kini menjadi solusi efisien untuk bisnis modern.",
    date: "01 Mei 2026",
    category: "Automation",
    slug: "https://business.whatsapp.com"
  }
];
---

<Layout title="Blog & Insights | TunamSam">
  <Navbar />
  <main class="pt-32 pb-24 px-6 min-h-screen">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16 relative">
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-64 h-64 bg-primary/20 blur-[100px] rounded-full -z-10"></div>
        <h1 class="text-5xl md:text-7xl font-black mb-6 tracking-tighter">Insights & <span class="text-primary">News</span></h1>
        <p class="text-gray-400 text-lg max-w-2xl mx-auto">
          Artikel terbaru seputar teknologi web, otomatisasi bisnis, dan strategi digital.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {posts.map(post => (
          <a href={post.slug} target="_blank" rel="noopener noreferrer" class="group bg-softdark border border-white/10 p-8 rounded-3xl hover:border-primary/50 hover:bg-white/5 transition-all">
            <div class="flex items-center gap-4 mb-4">
              <span class="text-primary text-xs font-bold uppercase tracking-widest">{post.category}</span>
              <span class="text-gray-500 text-xs">•</span>
              <span class="text-gray-500 text-xs">{post.date}</span>
            </div>
            <h3 class="text-2xl font-bold mb-3 text-white group-hover:text-primary transition-colors">{post.title}</h3>
            <p class="text-gray-400 text-sm leading-relaxed mb-6">{post.excerpt}</p>
            <div class="text-primary text-sm font-bold flex items-center gap-2">
              Read Article <span class="group-hover:translate-x-1 transition-transform">→</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </main>
  <Footer />
</Layout>