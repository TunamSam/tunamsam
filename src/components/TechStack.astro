---
const techs = [
  "Astro", "Tailwind CSS", "React", "Next.js", "Node.js", 
  "TypeScript", "PostgreSQL", "Cloudflare", "Docker", "Laravel"
];

const marqueeItems = [...techs, ...techs];
---

<section class="py-16 overflow-hidden border-y border-white/5 bg-softdark/30">
  <div class="max-w-7xl mx-auto px-6 mb-8 text-center">
    <h3 class="text-sm font-bold tracking-widest uppercase text-gray-500">Tech Stack & Tools</h3>
  </div>
  
  <div class="relative flex overflow-x-hidden group">
    <div class="animate-marquee whitespace-nowrap flex items-center gap-16 px-8">
      {marqueeItems.map(tech => (
        <span class="text-3xl md:text-5xl font-black text-white/10 hover:text-primary transition-colors cursor-default duration-300">
          {tech}
        </span>
      ))}
    </div>
  </div>
</section>

<style>
  @keyframes marquee {
    0% { transform: translateX(0%); }
    100% { transform: translateX(-50%); }
  }
  
  .animate-marquee {
    animation: marquee 25s linear infinite;
    width: max-content;
  }
  
  .animate-marquee:hover {
    animation-play-state: paused;
  }
</style>