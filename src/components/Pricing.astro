---
const plans = [
  {
    name: "Starter",
    target: "Landing page sederhana.",
    price: "Mulai Rp 1,5 Jt",
    features: ["1 Halaman Landing Page", "Desain Responsif", "SEO Basic", "Revisi 2x"],
    isPopular: false
  },
  {
    name: "Business",
    target: "Company profile + SEO.",
    price: "Mulai Rp 4 Jt",
    features: ["Hingga 5 Halaman", "Premium Custom UI", "SEO Optimized", "Integrasi WhatsApp", "Revisi 5x"],
    isPopular: true
  },
  {
    name: "Premium",
    target: "Dashboard + Automation.",
    price: "Custom",
    features: ["Full Stack Development", "Database & API", "Telegram Bot/Mini App", "Admin Dashboard", "Maintenance"],
    isPopular: false
  }
];
---

<section id="pricing" class="max-w-7xl mx-auto px-6 py-24">
  <div class="text-center mb-16">
    <h2 class="text-3xl md:text-5xl font-bold mb-4">Pricing Plans</h2>
    <p class="text-gray-400 max-w-2xl mx-auto">Pilih paket yang paling sesuai dengan skala bisnis Anda.</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-center">
    {plans.map(plan => (
      <div class={`relative bg-softdark border p-8 rounded-3xl transition-transform duration-300 ${plan.isPopular ? 'border-primary shadow-[0_0_30px_rgba(0,255,163,0.15)] md:-translate-y-4' : 'border-white/10 hover:border-white/30'}`}>
        {plan.isPopular && (
          <div class="absolute -top-4 left-1/2 -translate-x-1/2 bg-primary text-dark text-xs font-bold px-4 py-1 rounded-full uppercase tracking-wider">
            Most Popular
          </div>
        )}
        <h3 class="text-2xl font-bold mb-2">{plan.name}</h3>
        <p class="text-gray-400 text-sm mb-6 h-10">{plan.target}</p>
        <div class="text-3xl font-black mb-8 text-white">{plan.price}</div>
        
        <ul class="space-y-4 mb-8">
          {plan.features.map(feature => (
            <li class="flex items-center text-sm text-gray-300">
              <span class="text-primary mr-3 font-bold">✓</span>
              {feature}
            </li>
          ))}
        </ul>
        
        <a href="#contact" class={`block text-center py-3 rounded-xl font-bold transition-colors ${plan.isPopular ? 'bg-primary text-dark hover:bg-primary/90' : 'bg-white/5 text-white hover:bg-white/10 border border-white/10'}`}>
          Pilih {plan.name}
        </a>
      </div>
    ))}
  </div>
</section>