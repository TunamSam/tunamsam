---
import { MessageCircle, Send } from 'lucide-astro';
---

<section id="contact" class="pt-32 pb-24 px-6">
  <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
    <div>
      <h1 class="text-5xl md:text-7xl font-black mb-8 tracking-tighter">
        Let's Build <br />
        <span class="text-primary italic">Together</span>
      </h1>

      <p class="text-gray-400 text-lg mb-12 max-w-md">
        Punya ide project atau ingin konsultasi? Tim TunamSam siap membantu
        mewujudkan produk digital impian Anda.
      </p>

      <div class="space-y-6">
        <a
          href="https://wa.me/+6285195901406"
          class="flex items-center gap-6 p-6 bg-softdark border border-white/10 rounded-3xl hover:border-primary/50 hover:bg-white/5 transition-all group"
        >
          <div class="w-14 h-14 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center text-gray-300 group-hover:text-primary group-hover:border-primary/30 group-hover:bg-primary/10 transition-all duration-300 group-hover:scale-110 group-hover:shadow-[0_0_20px_rgba(0,255,163,0.2)]">
            <MessageCircle class="w-7 h-7 stroke-[1.5]" />
          </div>

          <div>
            <h4 class="font-bold text-white group-hover:text-primary transition-colors">
              WhatsApp
            </h4>
            <p class="text-sm text-gray-500">
              Fast response (09:00 - 21:00 WIB)
            </p>
          </div>
        </a>

        <a
          href="https://t.me/@zayssme"
          class="flex items-center gap-6 p-6 bg-softdark border border-white/10 rounded-3xl hover:border-primary/50 hover:bg-white/5 transition-all group"
        >
          <div class="w-14 h-14 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center text-gray-300 group-hover:text-primary group-hover:border-primary/30 group-hover:bg-primary/10 transition-all duration-300 group-hover:scale-110 group-hover:shadow-[0_0_20px_rgba(0,255,163,0.2)]">
            <Send class="w-7 h-7 stroke-[1.5]" />
          </div>

          <div>
            <h4 class="font-bold text-white group-hover:text-primary transition-colors">
              Telegram
            </h4>
            <p class="text-sm text-gray-500">
              Dukungan teknis & diskusi project
            </p>
          </div>
        </a>
      </div>
    </div>

    <div class="bg-softdark border border-white/10 p-8 md:p-12 rounded-[40px] shadow-2xl relative overflow-hidden">
      <div class="absolute -top-20 -right-20 w-64 h-64 bg-primary/10 blur-[80px] rounded-full pointer-events-none"></div>

      <form class="space-y-6 relative z-10">
        <div>
          <label class="block text-sm font-medium text-gray-400 mb-2">
            Nama Lengkap
          </label>
          <input
            type="text"
            class="w-full bg-dark border border-white/10 rounded-xl px-4 py-3 focus:border-primary focus:ring-1 focus:ring-primary/50 outline-none text-white transition-all placeholder:text-gray-600"
            placeholder="John Doe"
          />
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-400 mb-2">
            Email Bisnis
          </label>
          <input
            type="email"
            class="w-full bg-dark border border-white/10 rounded-xl px-4 py-3 focus:border-primary focus:ring-1 focus:ring-primary/50 outline-none text-white transition-all placeholder:text-gray-600"
            placeholder="john@company.com"
          />
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-400 mb-2">
            Pesan / Detail Project
          </label>
          <textarea
            rows="4"
            class="w-full bg-dark border border-white/10 rounded-xl px-4 py-3 focus:border-primary focus:ring-1 focus:ring-primary/50 outline-none text-white transition-all placeholder:text-gray-600 resize-none"
            placeholder="Ceritakan project Anda..."
          ></textarea>
        </div>

        <button
          type="submit"
          class="w-full bg-primary text-dark py-4 rounded-xl font-bold text-lg hover:shadow-[0_0_20px_rgba(0,255,163,0.3)] hover:scale-[1.02] active:scale-95 transition-all"
        >
          Send Message
        </button>
      </form>
    </div>
  </div>
</section>