---
const steps = ["Discussion", "Planning", "Design", "Development", "Launch", "Support"];
---

<section class="bg-softdark/30 py-24">
  <div class="max-w-7xl mx-auto px-6">
    <h2 class="text-center text-3xl font-bold mb-16">Our Workflow</h2>
    <div class="relative flex flex-col md:flex-row justify-between gap-8">
      {steps.map((step, index) => (
        <div class="flex-1 relative z-10 text-center">
          <div class="w-12 h-12 bg-dark border border-primary/50 text-primary rounded-full flex items-center justify-center mx-auto mb-4 font-bold shadow-[0_0_15px_rgba(0,255,136,0.3)]">
            {index + 1}
          </div>
          <h4 class="font-bold text-sm uppercase tracking-wider">{step}</h4>
        </div>
      ))}
      <div class="hidden md:block absolute top-6 left-0 w-full h-px bg-white/10 z-0"></div>
    </div>
  </div>
</section>