---
import {
  Zap,
  Cpu,
  Smartphone
} from "lucide-astro";

const features = [
  {
    title: "Lightning Fast Performance",
    desc:
      "Website dioptimasi untuk kecepatan tinggi dengan skor Lighthouse 90+ agar pengunjung tidak pergi sebelum halaman terbuka.",
    icon: Zap
  },

  {
    title: "Modern & Scalable Technology",
    desc:
      "Dibangun menggunakan Astro, React, dan Tailwind untuk performa maksimal, keamanan lebih baik, dan mudah dikembangkan.",
    icon: Cpu
  },

  {
    title: "Fully Responsive Experience",
    desc:
      "Tampilan sempurna di semua perangkat mulai dari smartphone, tablet, hingga desktop modern.",
    icon: Smartphone
  }
];
---

<section
  id="why-us"
  class="relative py-32 px-6 border-t border-white/5 overflow-hidden"
>

  <!-- BACKGROUND GLOW -->
  <div class="absolute inset-0 -z-10">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-125 h-125 bg-primary/5 blur-[120px] rounded-full"></div>
  </div>

  <div class="max-w-7xl mx-auto">

    <!-- HEADING -->
    <div class="text-center mb-20 max-w-3xl mx-auto">
      <span class="text-primary text-sm font-bold tracking-[0.2em] uppercase">
        Why Choose Us
      </span>

      <h2 class="text-5xl md:text-6xl font-black mt-6 mb-6 leading-tight">
        Built For Modern
        <span class="text-primary italic"> Digital Growth</span>
      </h2>

      <p class="text-gray-400 text-lg leading-relaxed">
        Kami membantu bisnis membangun pengalaman digital yang cepat,
        modern, dan scalable dengan teknologi terbaru yang siap
        berkembang bersama bisnis Anda.
      </p>
    </div>

    <!-- FEATURES -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">

      {features.map((f) => (
        <div
          class="group relative bg-white/3 border border-white/10 rounded-4xl p-8 hover:border-primary/30 hover:bg-white/5 transition-all duration-300 overflow-hidden"
        >

          <!-- CARD GLOW -->
          <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500">
            <div class="absolute top-0 right-0 w-40 h-40 bg-primary/10 blur-[80px] rounded-full"></div>
          </div>

          <!-- ICON -->
          <div
            class="relative mb-8 w-16 h-16 rounded-2xl bg-primary/10 border border-primary/20 flex items-center justify-center text-primary group-hover:scale-110 group-hover:rotate-6 transition-all duration-300"
          >
            <f.icon class="w-8 h-8 stroke-[1.8]" />
          </div>

          <!-- CONTENT -->
          <h3
            class="text-2xl font-bold mb-4 text-white group-hover:text-primary transition-colors"
          >
            {f.title}
          </h3>

          <p class="text-gray-400 leading-relaxed">
            {f.desc}
          </p>

        </div>
      ))}

    </div>
  </div>
</section>