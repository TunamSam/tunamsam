---
const projects = [
  {
    name: "SimAntrian Dashboard",
    category: "Web App / Admin",
    tech: ["Laravel", "React", "Tailwind"],
    image: "/path-to-image.jpg"
  },
  {
    name: "DikSera Landing Page",
    category: "Business Website",
    tech: ["Next.js", "TypeScript"],
    image: "/path-to-image-2.jpg"
  }
];
---

<section id="portfolio" class="max-w-7xl mx-auto px-6 py-24">
  <div class="flex justify-between items-end mb-12">
    <div>
      <h2 class="text-3xl md:text-5xl font-bold mb-2">Featured Work</h2>
      <p class="text-gray-400">Hasil karya terbaik yang kami kerjakan.</p>
    </div>
    <a href="/portfolio" class="text-primary hover:underline font-medium">View All Projects →</a>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    {projects.map(p => (
      <div class="group cursor-pointer">
        <div class="aspect-video bg-softdark border border-white/10 rounded-3xl overflow-hidden relative mb-6">
          <div class="absolute inset-0 bg-linear-to-t from-dark/80 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          <div class="w-full h-full flex items-center justify-center text-white/10 italic">Project Preview</div>
        </div>
        <div class="flex justify-between items-start px-2">
          <div>
            <p class="text-primary text-xs font-bold uppercase tracking-widest mb-1">{p.category}</p>
            <h3 class="text-2xl font-bold group-hover:text-primary transition-colors">{p.name}</h3>
          </div>
          <div class="flex gap-2">
            {p.tech.map(t => <span class="text-[10px] border border-white/20 px-2 py-1 rounded-full text-gray-400">{t}</span>)}
          </div>
        </div>
      </div>
    ))}
  </div>
</section>